{
  "name": "hombres-lobos-online",
  "version": "0.1.0",
  "description": "Juego en línea de deducción social Lobos contra Aldeanos, adaptado de la familia Mafia/Werewolf, con pantalla de narrador y de jugadores.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server/index.js",
    "dev": "node --watch --env-file-if-exists=.env server/index.js",
    "test": "node --test \"tests/**/*.test.js\"",
    "test:game": "node --test \"tests/game/**/*.test.js\"",
    "vendor": "node scripts/vendor.js",
    "bots": "node scripts/bots.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/atapia9/hombres-lobos-online.git"
  },
  "dependencies": {
    "express": "5.3.0",
    "helmet": "8.3.0",
    "socket.io": "4.8.4"
  },
  "devDependencies": {
    "socket.io-client": "4.8.4",
    "uqr": "0.1.3"
  }
}
