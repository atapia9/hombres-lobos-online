# Copy to .env and adjust. `npm start` loads it automatically when present.

# Port the server listens on.
PORT=3000

# Origins allowed to connect (comma-separated, origin only: no path).
# For GitHub Pages use https://<user>.github.io, not https://<user>.github.io/hombres-lobos-online
CORS_ORIGIN=https://atapia9.github.io

# development | production (production adds upgrade-insecure-requests to the CSP)
NODE_ENV=development
